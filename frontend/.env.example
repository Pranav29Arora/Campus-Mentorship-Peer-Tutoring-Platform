# CampusConnect Frontend Environment Variables Template

# Set to false in production to connect to the live backend REST API
VITE_USE_MOCK_DATA=false

# Live REST API & WebRTC Signaling Backend URL (e.g. https://api.campusconnect.edu or https://campusconnect-backend.onrender.com/api)
VITE_API_BASE_URL=http://localhost:5001/api

# WebRTC STUN Server (default: Google Public STUN)
VITE_STUN_SERVER=stun:stun.l.google.com:19302

# Optional TURN Servers for strict institutional/campus firewall traversal
VITE_TURN_SERVER=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

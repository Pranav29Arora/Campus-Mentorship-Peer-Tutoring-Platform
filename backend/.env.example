# CampusConnect Backend Environment Variables Template

# Port for Express REST & WebRTC Signaling Server
PORT=5001

# Strong cryptographic secret for signing JSON Web Tokens
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_in_production

# Frontend Origin URL for CORS (e.g. https://campusconnect.vercel.app or http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Supabase Project Connection Details
SUPABASE_URL=https://vxzbrmrnziaplrkbjhxc.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Environment Flag
NODE_ENV=production
